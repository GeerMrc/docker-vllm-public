# ==============================================================================
# Qwen3.6-27B-FP8 Docker 部署配置 — 双服务并行 (Primary + Secondary)
# 复制为 .env 后修改: cp .env.example .env
# 修改后执行: ./manage.sh restart all (或 restart primary / restart secondary)
# ==============================================================================

# === 项目 ===
COMPOSE_PROJECT_NAME=vllm-qwen36

# === 模型路径（宿主机 → 容器映射）===
VLLM_MODEL_PATH=/path/to/Qwen3.6-27B-FP8
VLLM_MODEL_DIR=Qwen3.6-27B-FP8

# === GPU 与运行时（共享）===
# GPU 显存利用率由各 profile YAML 中 gpu_memory_utilization 控制 (默认 0.97)
# 共享内存（TP>1 时必须 >= 4g）
VLLM_SHM_SIZE=4g

# === CPU 隔离（NUMA 拓扑相关，可选）===
# cpuset 将各服务线程绑定到指定 CPU 核心，避免双服务 ~1562 个线程竞争导致 decode 输出卡顿
# 不设置 = 不隔离（所有 CPU 共享），双服务高负载时可能输出卡顿
#
# 自动检测推荐值: ./manage.sh detect-topology
# 手动查看拓扑:   nvidia-smi topo -m    (CPU Affinity 列)
#
# 格式: 逗号分隔的 CPU 编号或范围，例如 "0-23,48-71"
#
# 配置策略（按硬件场景）:
#
#   多 NUMA 服务器 (AMD EPYC / Intel Xeon 双路):
#     每个 GPU 挂在不同 NUMA 节点 → 按 nvidia-smi topo -m 的 CPU Affinity 列配置
#     将服务的 CPU 绑定到其 GPU 所在 NUMA 节点的核心，减少跨 NUMA 延迟
#     示例: VLLM_PRIMARY_CPUSET=24-47,72-95    (GPU 0,1 对应的 NUMA 核心)
#
#   单 NUMA 节点 (消费级 CPU / 单路服务器):
#     所有 GPU 在同一 NUMA 节点 → NUMA 对齐无意义
#     可按核心数均分以减少线程竞争:
#     示例: VLLM_PRIMARY_CPUSET=0-15    VLLM_SECONDARY_CPUSET=16-31
#
#VLLM_PRIMARY_CPUSET=
#VLLM_SECONDARY_CPUSET=

# === NCCL 调优（多 GPU 拓扑相关）===
# NCCL_P2P_DISABLE: 禁用 GPU 间 P2P 直传，改用 SHM 共享内存
#   1 = 禁用（SYS 拓扑/跨 NUMA 节点时需要，防止 ncclCommInitRank 卡死）
#   留空 = 不设置（同 PCIe 总线多卡可保持默认，利用 P2P 加速）
# 部署前必查: nvidia-smi topo -m（GPU 间显示 SYS 则设为 1）
NCCL_P2P_DISABLE=

# === Docker Compose 内置环境变量（docker-compose.yml x-vllm-shared-env 已硬编码，一般无需修改）===
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False  # 必须为 False: True 会导致 CUDA Graph 捕获地址失效，prefill 阶段 OOM
# NCCL_IB_DISABLE=1                                    # 禁用 InfiniBand（RTX 3090 无 IB）
# VLLM_SKIP_P2P_CHECK=1                                # 跳过 P2P 检查
# VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1           # CUDA Graph 内存预估
# VLLM_CACHE_ROOT=/root/.cache/vllm                    # 编译缓存路径
# VLLM_USAGE_SOURCE=docker-custom-deploy               # 使用统计标记
# VLLM_LOGGING_CONFIG_PATH=/etc/vllm/logging.json      # Python logging 配置路径

# === 线程限制（防止 PyTorch/OpenBLAS 过度订阅）===
# 应与 cpuset 中的物理核心数一致: ./manage.sh apply-cpuset 后查看 VLLM_PRIMARY_CPUSET 计算物理核心数
# 默认 24 适配 4-NUMA-48物理核心服务器（每服务分配 24 物理核心）
#OMP_NUM_THREADS=24
#MKL_NUM_THREADS=24

# === 构建参数 ===
# 预编译镜像（推荐）: crpi-3jsqnspnt5spjb2h.ap-southeast-1.personal.cr.aliyuncs.com/maricgeer/vllm-qwen36:sm86-v0.21.0
# 源码构建后:         vllm-qwen36:rtx3090-sm86
DOCKER_IMAGE=crpi-3jsqnspnt5spjb2h.ap-southeast-1.personal.cr.aliyuncs.com/maricgeer/vllm-qwen36:sm86-v0.21.0

# === Primary 服务 (GPU 0,1 → 端口 8089) ===
# Profile 可自由切换: agent-fast (默认) / agent-thinking / code / instruct / think
# 切换方式: ./manage.sh set-profile primary <name> && ./manage.sh restart primary
VLLM_PRIMARY_PROFILE=agent-fast
# GPU 选择: 指定 nvidia-smi 编号的卡，卡数必须等于 profile 中 tensor_parallel_size
VLLM_PRIMARY_GPU_IDS=0,1
VLLM_PRIMARY_HOST_PORT=8089
# API Key（空 = 不鉴权；快速生成: python3 -c "import secrets; print(f'VLLM_PRIMARY_API_KEY=QW-{secrets.token_hex(16)}')"）
VLLM_PRIMARY_API_KEY=
# 日志目录固定为 ./logs/primary/（由 manage.sh 管理，无需手动设置）

# === Secondary 服务 (GPU 2,3 → 端口 8099) ===
# Profile 可自由切换: agent-thinking (默认) / agent-fast / code / instruct / think
# 切换方式: ./manage.sh set-profile secondary <name> && ./manage.sh restart secondary
VLLM_SECONDARY_PROFILE=agent-thinking
# GPU 选择: 指定 nvidia-smi 编号的卡，卡数必须等于 profile 中 tensor_parallel_size
VLLM_SECONDARY_GPU_IDS=2,3
VLLM_SECONDARY_HOST_PORT=8099
# API Key（空 = 不鉴权；快速生成: python3 -c "import secrets; print(f'VLLM_SECONDARY_API_KEY=QW-{secrets.token_hex(16)}')"）
VLLM_SECONDARY_API_KEY=
# 日志目录固定为 ./logs/secondary/（由 manage.sh 管理，无需手动设置）
